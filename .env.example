# Production üçün bu faylı .env kimi kopyalayın və dəyərləri dəyişin.
# Daha asan yol: ./scripts/bootstrap.sh (.env yoxdursa təhlükəsiz dəyərlər yaradır)

COMPOSE_PROJECT_NAME=hr-erp
ENVIRONMENT=production
APP_PORT=8000

POSTGRES_USER=hr
POSTGRES_DB=hr_erp
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Ən azı 32 simvol olmalıdır: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=480

AUTO_SEED=true
SEED_DEMO=false
INITIAL_ADMIN_EMAIL=admin@hr.local
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
INITIAL_ADMIN_NAME=Sistem Administratoru

ENABLE_DOCS=false
CORS_ORIGINS=
ALLOWED_HOSTS=
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
MAX_REQUEST_BYTES=2000000
TIMEZONE=Asia/Baku
